#!/usr/bin/env python3
"""Harness adapter: Claude Code.

A harness adapter is how the kernel starts a process's agent. The contract is
the same for every harness, so the kernel knows nothing about any of them:

  in   standard input        the prompt (the process's new messages)
       working directory     the process's own directory
       $JARVIS_SESSION       the session its last turn ended with, or empty
       $JARVIS_AGENT_DIR     a directory of this process's own, in the store,
                             for what its agent must have again next turn. It
                             is the same on every machine that uses the store,
                             and it is deleted when the process is removed
       $JARVIS_ID            the process's address
       $JARVIS_GUIDE         path to the guide every agent is given
       `jarvis` on $PATH     the command; `jarvis help` describes it
  out  standard output       JSON objects, one per line.
                             While the agent works, one line per step, which
                             the kernel records at once (`jarvis log --steps`):
                               {"step": what kind of step,
                                "text": the step, for a person to read,
                                ...anything else worth recording}
                             This adapter's kinds are `text` (the agent said
                             something), `thinking`, `tool` (it used a tool)
                             and `result` (what came back).
                             Then, as the last line, how the turn ended:
                               {"session": id to continue next time,
                                "reply":   what the agent said last,
                                "cost_usd": what this turn cost, if known; or
                                "cost_usd_session": what the whole session has
                                           cost so far, from which the kernel
                                           works out this turn's share,
                                ...anything else worth recording (time)}
       exit code             non-zero if the agent could not run

To support another harness, add another executable next to this one and
spawn processes with `--harness <its name>`.

What this adapter keeps. Claude Code is given $JARVIS_AGENT_DIR as its whole
configuration directory, so the agent's session is a file there and nowhere
else. The session's id is worked out from the process's address, so the
address alone finds it: each turn continues that session, and makes it if it
is not there. Nothing of the machine's own `~/.claude` is used, the login
included: the kernel must have been started with $CLAUDE_CODE_OAUTH_TOKEN
set, to a token made by `claude setup-token`.

What the agent may do is decided in two places.

  Every agent     the flags below: edit files in its own directory, use the
                  `jarvis` command, use all of git, search the web. Set
                  $JARVIS_CLAUDE_FLAGS to replace them (for example
                  `--dangerously-skip-permissions` to allow any command).
  Each process    `.jarvis/claude.json` in the process's directory, if it
                  exists: a Claude Code settings file. It is how a process is
                  given the tools its work needs, for example
                    {"permissions": {"allow": ["Bash(npm:*)", "Bash(cargo:*)"]}}
                  It is part of the process's code, so forks start with it and
                  the agent can change it. It is read at the start of each turn.

The settings are handed to Claude Code as text, not as a file. Claude Code
refuses to let an agent edit a file it was given as settings, and ignores a
`.claude/settings.json` in a directory nobody has approved by hand.
"""
import json
import os
import shlex
import subprocess
import sys
import tempfile
import uuid

# The most of a tool's input or output that is recorded for one step.
MOST = 4000

DEFAULT_FLAGS = [
    "--permission-mode", "acceptEdits",
    "--allowedTools",
    "Bash(jarvis:*)", "Bash(git:*)", "Bash(ls:*)", "Bash(cat:*)",
    "Read", "Edit", "Write", "Glob", "Grep", "WebSearch", "WebFetch",
]

NOT_LOGGED_IN = (
    "Claude is not logged in. An agent's sessions are kept in the store, and "
    "the login of this machine is not there, so the kernel must be started "
    "with CLAUDE_CODE_OAUTH_TOKEN set to a token made by `claude setup-token`. "
    "Stop the kernel and start it again from a shell that has it."
)

# Claude Code deletes sessions that were not used for this many days. It has
# no way to say never, so: a hundred years.
KEEP_DAYS = 36500

LOST = (
    "[jarvis] Your earlier session could not be continued, so you remember "
    "nothing from it. Read what is in your .jarvis directory before acting.\n\n"
)


OWN_SETTINGS = os.path.join(".jarvis", "claude.json")


def own_settings():
    """The process's own settings as text, and a notice if they are unusable."""
    try:
        with open(OWN_SETTINGS) as f:
            text = f.read()
    except FileNotFoundError:
        return None, ""
    except OSError as e:
        return None, f"[jarvis] `{OWN_SETTINGS}` could not be read ({e}), so it was not used.\n\n"
    try:
        if not isinstance(json.loads(text), dict):
            raise ValueError("it is not a JSON object")
    except ValueError as e:
        return None, (
            f"[jarvis] `{OWN_SETTINGS}` is not valid ({e}), so it was not used this "
            "turn: you have only the tools every agent has. Fix the file.\n\n"
        )
    return text, ""


def clip(text):
    return text if len(text) <= MOST else text[:MOST] + f"\n… ({len(text) - MOST} more characters)"


def emit(obj):
    print(json.dumps(obj), flush=True)


def tool_line(name, given):
    """One line saying what a tool was used for."""
    here = os.getcwd() + os.sep
    for key in ("command", "file_path", "pattern", "query", "url", "path", "prompt", "description"):
        value = given.get(key)
        if isinstance(value, str) and value:
            if value.startswith(here):
                value = value[len(here):]
            return f"{name}: {value}"
    return f"{name}: {json.dumps(given)}" if given else name


def result_text(content):
    if isinstance(content, str):
        return content
    parts = []
    for part in content or []:
        if isinstance(part, dict) and part.get("type") == "text":
            parts.append(part.get("text", ""))
        elif isinstance(part, dict):
            parts.append(f"[{part.get('type', 'something')}]")
    return "\n".join(parts)


def steps(event):
    """The steps in one line of Claude Code's output."""
    message = event.get("message")
    if event.get("type") not in ("assistant", "user") or not isinstance(message, dict):
        return
    content = message.get("content")
    if not isinstance(content, list):
        return
    # Set when the step was taken by a helper the agent started with a tool.
    inside = {"inside": event["parent_tool_use_id"]} if event.get("parent_tool_use_id") else {}
    for part in content:
        if not isinstance(part, dict):
            continue
        kind = part.get("type")
        if kind == "text" and part.get("text", "").strip():
            yield {"step": "text", "text": part["text"], **inside}
        elif kind == "thinking" and part.get("thinking", "").strip():
            yield {"step": "thinking", "text": part["thinking"], **inside}
        elif kind == "tool_use":
            given = part.get("input") or {}
            yield {
                "step": "tool",
                "text": clip(tool_line(part.get("name", "?"), given)),
                "tool": part.get("name"),
                "input": json.loads(json.dumps(given)) if len(json.dumps(given)) <= MOST else None,
                "id": part.get("id"),
                **inside,
            }
        elif kind == "tool_result":
            yield {
                "step": "result",
                "text": clip(result_text(part.get("content"))),
                "error": bool(part.get("is_error")),
                "id": part.get("tool_use_id"),
                **inside,
            }


def keep_in(directory):
    """Have Claude Code keep everything in this directory, and keep it for good."""
    os.makedirs(directory, exist_ok=True)
    os.environ["CLAUDE_CONFIG_DIR"] = directory
    settings = os.path.join(directory, "settings.json")
    if not os.path.exists(settings):
        with open(settings, "w") as f:
            json.dump({"cleanupPeriodDays": KEEP_DAYS}, f)


def claude(prompt, which, guide, settings):
    """Run one turn, printing its steps as they happen.

    `which` are the flags that say which session: continue one, or make one.
    Returns (exit code, the final result Claude Code reported or None, and
    everything else it printed, for error messages)."""
    command = ["claude", "-p", "--output-format", "stream-json", "--verbose", "--append-system-prompt", guide]
    command += which
    if settings:
        command += ["--settings", settings]
    flags = os.environ.get("JARVIS_CLAUDE_FLAGS")
    command += shlex.split(flags) if flags is not None else DEFAULT_FLAGS
    result, other = None, []
    with tempfile.TemporaryFile("w+") as errors:
        run = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors, text=True)
        try:
            run.stdin.write(prompt)
            run.stdin.close()
        except BrokenPipeError:
            pass
        for line in run.stdout:
            try:
                event = json.loads(line)
            except ValueError:
                other.append(line)
                continue
            if not isinstance(event, dict):
                other.append(line)
            elif event.get("type") == "result":
                result = event
            else:
                # Showing a step must never be what ends a turn.
                try:
                    for step in steps(event):
                        emit(step)
                except Exception as e:
                    emit({"step": "unreadable", "text": f"a step could not be shown ({e!r})"})
        code = run.wait()
        errors.seek(0)
        other.insert(0, errors.read())
    return code, result, "".join(other)


def main():
    prompt = sys.stdin.read()
    address = os.environ["JARVIS_ID"]
    keep_in(os.environ["JARVIS_AGENT_DIR"])
    # The same address always gives the same session.
    session = str(uuid.uuid5(uuid.NAMESPACE_URL, "jarvis:" + address))
    with open(os.environ["JARVIS_GUIDE"]) as f:
        guide = f.read()
    # The agent is also shown what `jarvis help` prints, so that the command
    # is described in one place only: its own help.
    overview = subprocess.run(["jarvis", "help"], capture_output=True, text=True)
    if overview.returncode == 0:
        guide += "\n## The `jarvis` command\n\nThis is what `jarvis help` prints:\n\n" + overview.stdout

    settings, notice = own_settings()
    prompt = notice + prompt
    code, out, said = claude(prompt, ["--resume", session], guide, settings)
    session_lost = False
    if code != 0 and "No conversation found" in said + json.dumps(out or {}):
        # There is none yet. If the kernel knows of an earlier turn, there
        # was one, and it is gone.
        session_lost = bool(os.environ.get("JARVIS_SESSION"))
        code, out, said = claude(
            (LOST if session_lost else "") + prompt, ["--session-id", session, "--name", address], guide, settings
        )

    if code != 0 or out is None or out.get("is_error"):
        problem = said.strip()
        if out and out.get("is_error"):
            problem = f"{out.get('result') or json.dumps(out)}\n{problem}"
        if "Not logged in" in problem:
            problem = f"{NOT_LOGGED_IN}\n{problem}"
        sys.stderr.write(problem or "claude produced no output\n")
        sys.exit(code or 1)

    emit({
        "session": out.get("session_id"),
        "reply": out.get("result") or "",
        "harness": "claude",
        # Claude Code reports what the session has cost in all, not this turn.
        "cost_usd_session": out.get("total_cost_usd"),
        "duration_ms": out.get("duration_ms"),
        "turns": out.get("num_turns"),
        "session_lost": session_lost,
    })


if __name__ == "__main__":
    main()
