#!/usr/bin/env python3
"""A harness for tests: no model. It answers each message it is given with
`ack <message>`, sent to the address the message came from."""
import json, os, re, subprocess, sys

prompt = sys.stdin.read()
# What it keeps between turns is in the directory it is given for that: here,
# how many turns it has had.
kept = os.path.join(os.environ["JARVIS_AGENT_DIR"], "turns")
os.makedirs(os.path.dirname(kept), exist_ok=True)
turns = int(open(kept).read()) if os.path.exists(kept) else 0
with open(kept, "w") as f:
    f.write(str(turns + 1))
print(json.dumps({"step": "text", "text": "Reading my messages."}), flush=True)
for found in re.finditer(r"--- message (\S+) from (\S+) ---\n(.*)", prompt):
    message, sender, first = found.groups()
    # Not what jarvis itself says, and not answers: or two of these would never stop.
    if first.startswith("[jarvis]") or first.startswith("ack ") or sender.startswith("kernel@"):
        continue
    subprocess.run(["jarvis", "send", sender, f"ack {message}"], capture_output=True)
print(json.dumps({"session": "s", "reply": "Answered what was due.", "cost_usd": 0.0}))
